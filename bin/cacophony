#!/usr/bin/env node
import * as path from "node:path";
import * as fs from "node:fs";
import { backup } from "@cacophony/tools";

// Resolve compiled CLI entrypoint from engine dist
const cliPath = path.resolve(import.meta.dirname, "../packages/engine/dist/cli/runCli.js");

if (!fs.existsSync(cliPath)) {
  console.error("Error: Cacophony CLI distribution bundle not found. Please run 'npm run build' first.");
  process.exit(1);
}

await import(cliPath);

/**
 * Adds a backup command to the cacophony CLI.
 * This function creates a new `backup` subcommand that utilizes the `@cacophony/tools` package
 * to perform backups with timestamped snapshots, suitable for cron-driven automated backups.
 */
async function main() {
  try {
    await backup(); // Execute the backup command from the tools package.
  } catch (error) {
    console.error("Error during backup process:", error);
    process.exit(1);
  }
}

main();
