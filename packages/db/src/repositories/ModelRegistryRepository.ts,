import { ModelRegistryRecord } from '../models/ModelRegistryRecord';
import { IDatabaseDriver } from '../interfaces/IDatabaseDriver';
import { DatabaseDriverFactory } from '../drivers/DatabaseDriverFactory';
import { inject, singleton } from 'inversify';
import { Logger } from '@cacophony/tools';

@singleton()
export class ModelRegistryRepository implements ModelRegistryRepository {
  private readonly logger = new Logger(ModelRegistryRepository.name);

  constructor(@inject('DatabaseDriverFactory') private databaseDriverFactory: DatabaseDriverFactory) {}

  async getModelRegistry(): Promise<ModelRegistryRecord[]> {
    const driver = this.databaseDriverFactory.getDriver();
    if (!driver) {
      this.logger.error('Failed to obtain database driver.');
      return [];
    }

    try {
      const result = await driver.query(`
        SELECT id, model_name, active, context_size
        FROM model_registry;
      `);

      const records: ModelRegistryRecord[] = result.rows.map((row) => ({
        id: row.id,
        model_name: row.model_name,
        active: row.active === 1,
        context_size: row.context_size,
      }));

      return records;
    } catch (error) {
      this.logger.error('Error retrieving model registry:', error);
      throw error;
    }
  }

  async setModelRegistryActive(modelName: string, active: boolean): Promise<void> {
    const driver = this.databaseDriverFactory.getDriver();
    if (!driver) {
      this.logger.error('Failed to obtain database driver.');
      return;
    }

    try {
      await driver.query(`
        UPDATE model_registry
        SET active = $1
        WHERE model_name = $2;
      `, [active, modelName]);
    } catch (error) {
      this.logger.error('Error setting model registry active:', error);
      throw error;
    }
  }

  async setModelRegistryContextSize(modelName: string, contextSize: number): Promise<void> {
    const driver = this.databaseDriverFactory.getDriver();
    if (!driver) {
      this.logger.error('Failed to obtain database driver.');
      return;
    }

    try {
      await driver.query(`
        UPDATE model_registry
        SET context_size = $1
        WHERE model_name = $2;
      `, [contextSize, modelName]);
    } catch (error) {
      this.logger.error('Error setting model registry context size:', error);
      throw error;
    }
  }
}

export interface ModelRegistryRepository {
  getModelRegistry(): Promise<ModelRegistryRecord[]>;
  setModelRegistryActive(modelName: string, active: boolean): Promise<void>;
  setModelRegistryContextSize(modelName: string, contextSize: number): Promise<void>;
}
