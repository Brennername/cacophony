import { ModelProfileRepository } from '../repositories/ModelProfileRepository';
import { StackProfileRepositoryInterface } from './StackProfileRepositoryInterface';
import { ModelTuningProfileDbRow } from '../repositories/ModelProfileRepository';

export class StackProfileRepository implements StackProfileRepositoryInterface {

  private readonly modelProfileRepository: ModelProfileRepository;

  constructor(modelProfileRepository: ModelProfileRepository) {
    this.modelProfileRepository = modelProfileRepository;
  }

  async getStackProfile(stackId: string): Promise<ModelTuningProfileDbRow | null> {
    // Retrieve the stack profile from the database based on the provided stack ID.
    const stackProfile = await this.modelProfileRepository.getProfileByStackId(stackId);

    if (!stackProfile) {
      return null; // Return null if the stack profile is not found.
    }

    return stackProfile;
  }

  async updateStackProfile(stackId: string, newProfile: ModelTuningProfileDbRow): Promise<void> {
    // Update the stack profile in the database with the provided new profile data.
    await this.modelProfileRepository.updateProfile(stackId, newProfile);
  }

  async deleteStackProfile(stackId: string): Promise<void> {
    // Delete the stack profile from the database based on the provided stack ID.
    await this.modelProfileRepository.deleteProfile(stackId);
  }
}
