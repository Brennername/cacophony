import { Component, signal, computed } from 'signal';
import { TerminalLogLine } from '@cacophony/shared-types';
import { inject } from '@angular/core';
import { ArenaStateStore } from '../services/arena-state.store';
import { TaskApiService } from '../services/task-api.service';

export interface TerminalLogViewerComponentProps {
  logLines: TerminalLogLine[];
}

@Component({
  selector: 'app-terminal-log-viewer',
  template: `
    <div class="terminal-log-viewer">
      <pre>
        ${logLines.map(line => line.text).join('\n')}
      </pre>
    </div>
  `,
})
export class TerminalLogViewerComponent implements TerminalLogViewerComponentProps {
  logLines = signal([]);

  constructor(
    private arenaStateStore: ArenaStateStore,
    private taskApiService: TaskApiService
  ) {}

  ngOnInit(): void {
    this.loadLogLines();
  }

  private loadLogLines(): void {
    this.taskApiService.getTaskLogs().subscribe((logs) => {
      this.logLines.set(logs);
    });
  }
}
