import { Component, OnInit } from '@angular/core';
import { RepoSymbolNode } from '../repo-state.service';

@Component({
  selector: 'app-repo-map-viewer',
  templateUrl: './repo-map-viewer.component.html',
  styleUrls: ['./repo-map-viewer.component.css']
})
export class RepoMapViewerComponent implements OnInit {
  repoSymbols: RepoSymbolNode[] = [];

  constructor() { }

  ngOnInit(): void {
    // Initialize with some sample data
    this.repoSymbols = [
      { id: '1', name: 'RepoA', children: [] },
      { id: '2', name: 'RepoB', children: [{ id: '3', name: 'SubRepoB1', children: [] }] }
    ];
  }

  onTreeNodeExpand(node: RepoSymbolNode): void {
    // Simulate tree node expansion
    if (node.children.length === 0) {
      // Fetch and set children for the expanded node
      node.children = [
        { id: '4', name: 'SubRepoA1', children: [] },
        { id: '5', name: 'SubRepoA2', children: [] }
      ];
    }
  }

  onSymbolSelect(symbol: RepoSymbolNode): void {
    // Simulate symbol selection
    console.log('Selected symbol:', symbol);
  }

  onFileNavigate(file: string): void {
    // Simulate file navigation dispatch
    console.log('Navigating to file:', file);
  }
}
