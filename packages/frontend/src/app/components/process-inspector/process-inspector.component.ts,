import { Component, Input, Output, EventEmitter } from '@angular/core';
import { ProcessItem } from '@cacophony/shared-types';

@Component({
  selector: 'app-process-inspector',
  templateUrl: './process-inspector.component.html',
  styleUrls: ['./process-inspector.component.css'],
})
export class ProcessInspectorComponent {
  @Input() processItem!: ProcessItem;
  @Output() onProcessSelected = new EventEmitter<ProcessItem>();

  constructor() {}

  onSelectProcess(): void {
    this.onProcessSelected.emit(this.processItem);
  }
}
