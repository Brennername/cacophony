{
  "name": "@cacophony/shared-types",
  "version": "1.0.0",
  "description": "Shared TypeScript interfaces, domain schemas, and contracts for Cacophony",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
