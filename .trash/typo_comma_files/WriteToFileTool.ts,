import { ToolExecutionContext, ICacophonyTool } from '@cacophony/shared-types';
import { resolveSafePath } from '../utils/pathSecurity';

interface WriteToFileParams {
  filePath: string;
  content: string;
  overwrite?: boolean;
}

export class WriteToFileTool implements ICacophonyTool {
  public static readonly ParamsSchema = {
    type: 'object',
    properties: {
      filePath: { type: 'string' },
      content: { type: 'string' },
      overwrite: { type: 'boolean', default: true }
    },
    required: ['filePath', 'content']
  };

  public async execute(context: ToolExecutionContext, params: WriteToFileParams): Promise<void> {
    const safePath = resolveSafePath(params.filePath);
    if (!safePath) {
      throw new Error('Invalid file path');
    }

    try {
      const stats = await Deno.stat(safePath);
      if (stats.isFile && !params.overwrite) {
        throw new Error(`File ${safePath} already exists and overwrite is not allowed`);
      }
    } catch (error) {
      if (!(error instanceof Deno.errors.NotFound)) {
        throw error;
      }
    }

    await Deno.writeTextFile(safePath, params.content);
  }
}
