import { Component, EventEmitter, Input, Output } from '@angular/core';

@Component({
  selector: 'app-frontier-modal',
  templateUrl: './frontier-modal.component.html',
  styleUrls: ['./frontier-modal.component.css']
})
export class FrontierModalComponent {
  @Input() providerCredentials: string;
  @Input() temperature: number;
  @Output() submitEvent = new EventEmitter<void>();

  onProviderCredentialChange(event: Event) {
    const inputElement = event.target as HTMLInputElement;
    this.providerCredentials = inputElement.value;
  }

  onTemperatureChange(event: Event) {
    const inputElement = event.target as HTMLInputElement;
    this.temperature = parseFloat(inputElement.value);
  }

  onSubmit() {
    this.submitEvent.emit();
  }
}
