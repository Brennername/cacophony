import { Component, Input, Output, EventEmitter, OnInit } from '@angular/core';
import { ModelPullModalDialogService } from '../../services/model-pull-modal-dialog.service';
import { ArenaStateStore } from '../../services/arena-state.store';
import { TaskItem } from '../../services/task-api.service';

@Component({
  selector: 'app-model-pull-modal',
  templateUrl: './model-pull-modal.component.html',
  styleUrls: ['./model-pull-modal.component.css']
})
export class ModelPullModalComponent implements OnInit {

  @Input() taskItem!: TaskItem;
  @Output() cancelPull = new EventEmitter<void>();
  @Output() startPull = new EventEmitter<void>();

  isLoading = false;
  pullProgress = 0;

  constructor(private dialogService: ModelPullModalDialogService, private arenaStateStore: ArenaStateStore) {}

  ngOnInit(): void {
    // No initialization logic needed for this component.
  }

  onCancel(): void {
    this.cancelPull.emit();
  }

  onStartPull(): void {
    this.isLoading = true;
    this.pullProgress = 0;
    this.startPull.emit();
    // Simulate a pull operation with progress updates
    const intervalId = setInterval(() => {
      this.pullProgress += 10;
      if (this.pullProgress >= 100) {
        clearInterval(intervalId);
        this.isLoading = false;
      }
    }, 500);
  }

}
