import { ITaskHistorySource } from '@cacophony/shared-types';
import { assert } from 'node:assert/strict';

export class RollingWindowAnalyticsService {
  private readonly taskHistorySource: ITaskHistorySource;

  constructor(taskHistorySource: ITaskHistorySource) {
    this.taskHistorySource = taskHistorySource;
  }

  /**
   * Calculates the moving average latency for a given time window.
   * @param history The task history data.
   * @param windowSize The size of the rolling window in milliseconds.
   * @returns An array of latencies representing the moving average latency within each window.
   */
  public calculateMovingAverageLatency(history: TaskHistoryItem[], windowSize: number): number[] {
    const result: number[] = [];
    for (let i = 0; i < history.length - windowSize + 1; i++) {
      const window = history.slice(i, i + windowSize);
      const totalLatency = window.reduce((sum, item) => sum + item.latency, 0);
      result.push(totalLatency / window.length);
    }
    return result;
  }

  /**
   * Calculates the percentile latency for a given time window.
   * @param history The task history data.
   * @param windowSize The size of the rolling window in milliseconds.
   * @param percentile The desired percentile (e.g., 95).
   * @returns The latency at the specified percentile within the window.
   */
  public calculatePercentileLatency(history: TaskHistoryItem[], windowSize: number, percentile: number): number {
    const latencies = this.calculateMovingAverageLatency(history, windowSize);
    latencies.sort((a, b) => a - b);
    const index = (percentile / 100) * (latencies.length - 1);
    if (index >= latencies.length - 1) {
      return latencies[latencies.length - 1];
    }
    return latencies[Math.floor(index)];
  }

  /**
   * Aggregates throughput data within a rolling window.
   * @param history The task history data.
   * @param windowSize The size of the rolling window in milliseconds.
   * @returns An array representing the aggregated throughput for each window.
   */
  public aggregateThroughput(history: TaskHistoryItem[], windowSize: number): number[] {
    const result: number[] = [];
    for (let i = 0; i < history.length - windowSize + 1; i++) {
      const window = history.slice(i, i + windowSize);
      const totalThroughput = window.reduce((sum, item) => sum + item.throughput, 0);
      result.push(totalThroughput / windowSize);
    }
    return result;
  }
}

interface TaskHistoryItem {
  timestamp: number;
  latency: number;
  throughput: number;
}
