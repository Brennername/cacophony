import { describe, it } from 'node:test';
import assert from 'node:assert/strict';

// Assuming TaskTelemetryCorrelationRepository is already defined and exported from its file
import { TaskTelemetryCorrelationRepository, TaskTelemetryCorrelationRecord } from '../repositories/TaskTelemetryCorrelationRepository';

describe('TaskTelemetryCorrelationRepository', () => {
  let repository: TaskTelemetryCorrelationRepository;

  beforeEach(async () => {
    // Initialize the repository before each test
    repository = new TaskTelemetryCorrelationRepository();
    await repository.initialize(); // Assuming initialize method exists to set up the database connection
  });

  afterEach(async () => {
    // Clean up after each test
    await repository.closeConnection(); // Assuming closeConnection method exists to clean up resources
  });

  it('should insert a metric point', async () => {
    const record: TaskTelemetryCorrelationRecord = {
      id: 'test-id',
      timestamp: new Date(),
      value: 123.45,
      correlationId: 'correlation-id'
    };

    await repository.insert(record);
    const insertedRecord = await repository.findById('test-id');
    assert.deepStrictEqual(insertedRecord, record);
  });

  it('should query metric points within a time range', async () => {
    const start = new Date();
    const end = new Date(start.getTime() + 1000);

    const records: TaskTelemetryCorrelationRecord[] = [
      { id: 'test-id-1', timestamp: start, value: 123.45, correlationId: 'correlation-id-1' },
      { id: 'test-id-2', timestamp: end, value: 678.90, correlationId: 'correlation-id-2' }
    ];

    for (const record of records) {
      await repository.insert(record);
    }

    const queriedRecords = await repository.findByTimeRange(start, end);
    assert.deepStrictEqual(queriedRecords, records);
  });

  it('should perform correlation rollup', async () => {
    const start = new Date();
    const end = new Date(start.getTime() + 1000);

    const records: TaskTelemetryCorrelationRecord[] = [
      { id: 'test-id-1', timestamp: start, value: 123.45, correlationId: 'correlation-id' },
      { id: 'test-id-2', timestamp: end, value: 678.90, correlationId: 'correlation-id' }
    ];

    for (const record of records) {
      await repository.insert(record);
    }

    const rollup = await repository.correlate('correlation-id', start, end);
    assert.strictEqual(rollup.sum, 123.45 + 678.90);
    assert.strictEqual(rollup.count, 2);
  });
});
