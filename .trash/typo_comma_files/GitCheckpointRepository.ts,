import { describe, it } from 'node:test';
import assert from 'node:assert/strict';

// Assuming GitCheckpointRepository and related types are defined in the same file
import { GitCheckpointRecord, GitCheckpointRepository } from './GitCheckpointRepository';

describe('GitCheckpointRepository', () => {
  let gitCheckpointRepository: GitCheckpointRepository;

  beforeEach(() => {
    // Initialize the repository before each test
    gitCheckpointRepository = new GitCheckpointRepository();
  });

  it('should create a checkpoint with correct SHA and parent commit', async () => {
    const sha = 'abc123';
    const parentCommit = 'def456';

    await gitCheckpointRepository.createCheckpoint(sha, parentCommit);

    // Assuming there's a method to retrieve the latest checkpoint
    const latestCheckpoint = await gitCheckpointRepository.getLatestCheckpoint();

    assert.strictEqual(latestCheckpoint.sha, sha);
    assert.strictEqual(latestCheckpoint.parentCommit, parentCommit);
  });

  it('should retrieve SHA for a given commit', async () => {
    const sha = 'abc123';
    const expectedSHA = 'def456';

    // Assuming there's a method to set the SHA for a commit
    await gitCheckpointRepository.setShaForCommit(sha, expectedSHA);

    const retrievedSHA = await gitCheckpointRepository.getShaForCommit(sha);

    assert.strictEqual(retrievedSHA, expectedSHA);
  });

  it('should track parent commit correctly', async () => {
    const sha = 'abc123';
    const parentCommit = 'def456';

    // Assuming there's a method to set the parent commit for a checkpoint
    await gitCheckpointRepository.setParentCommit(sha, parentCommit);

    const retrievedParentCommit = await gitCheckpointRepository.getParentCommit(sha);

    assert.strictEqual(retrievedParentCommit, parentCommit);
  });
});
