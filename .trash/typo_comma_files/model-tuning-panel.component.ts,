import { Component, Input, Output, EventEmitter, OnInit } from '@angular/core';
import { Signal } from '@angular/signals';
import { ArenaStateStore } from '../services/arena-state.store';
import { TaskApiService } from '../services/task-api.service';

@Component({
  selector: 'app-model-tuning-panel',
  templateUrl: './model-tuning-panel.component.html',
  styleUrls: ['./model-tuning-panel.component.css'],
})
export class ModelTuningPanelComponent implements OnInit {
  @Input() taskId: string = '';
  @Output() onResetDefaults = new EventEmitter<void>();

  sliderValue: Signal<number> = 100; // Initial slider value (e.g., 100%)
  presetValues: Signal<{ [key: string]: number }> = new Signal({});

  constructor(private arenaStateStore: ArenaStateStore, private taskApiService: TaskApiService) {}

  ngOnInit(): void {
    this.loadPreset();
  }

  loadPreset(): void {
    // Placeholder for loading preset values from storage or API
    const savedPresets = this.taskApiService.getTaskPreset(this.taskId); // Assuming a method to retrieve presets
    if (savedPresets) {
      this.presetValues = new Signal(savedPresets);
    } else {
      this.presetValues = new Signal({});
    }
  }

  resetDefaults(): void {
    this.sliderValue = 100; // Reset slider to default value
    this.presetValues = new Signal({});
    this.onResetDefaults.emit();
  }

  updateSliderValue(value: number): void {
    this.sliderValue = new Signal(value);
  }
}
